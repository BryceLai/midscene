ENGINE_API_TOKEN=replace-with-a-random-token-at-least-24-characters
ENGINE_HOST=127.0.0.1
ENGINE_PORT=8080
ENGINE_DATA_DIR=./data
ANDROID_SERIAL=replace-with-adb-device-serial

# Existing cmb.pb WebView used to open the app route. Required if multiple pages exist.
CMB_LAUNCHER_URL_PREFIX=
# Narrow this list to the actual mini app hosts in your deployment.
CMB_WEBVIEW_HOSTS=*.cmbchina.com
# Optional exact labels for navigation buttons. Unknown buttons are blocked by default.
CMB_NAVIGATION_LABELS=
# Best-effort wrapping of JSBridge functions; metadata only. Disabled by default.
CMB_CAPTURE_BRIDGE=false

# Configure using https://midscenejs.com/model-config
MIDSCENE_MODEL_BASE_URL=
MIDSCENE_MODEL_API_KEY=
MIDSCENE_MODEL_NAME=
MIDSCENE_MODEL_FAMILY=

# A private S3-compatible bucket; credentials use the standard AWS SDK provider chain.
S3_ENDPOINT=
S3_BUCKET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_KEY_PREFIX=webview-tasks
S3_URL_TTL_SECONDS=900
# Optional AES256 if supported by the object storage service.
S3_ENCRYPTION=
